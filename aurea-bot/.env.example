# === Обязательные параметры ===
# Токен бота от @BotFather (https://t.me/BotFather)
BOT_TOKEN=

# ID чата администратора (куда приходят уведомления о новых записях).
# Узнать свой ID можно у @userinfobot. Должно быть числом.
ADMIN_CHAT_ID=

# === Необязательные параметры (есть значения по умолчанию) ===
# Таймзона клиники (IANA). По умолчанию Europe/Moscow.
TIMEZONE=Europe/Moscow

# Ссылка на политику конфиденциальности (ДЕМО — заменить на реальную перед запуском).
POLICY_URL=https://aurea-lips.netlify.app/

# Ссылка на согласие на обработку персональных данных (ДЕМО — заменить на реальную перед запуском).
CONSENT_URL=https://aurea-lips.netlify.app/

# Путь к файлу базы данных (по умолчанию bot.db в корне проекта).
# DB_PATH=bot.db
